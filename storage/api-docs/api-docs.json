{
    "openapi": "3.0.0",
    "info": {
        "title": "VitalCare Pharmacy API Documentation",
        "description": "Interactive REST API documentation for VitalCare Pharmacy. Explore endpoints, test requests directly, and inspect schemas.",
        "contact": {
            "name": "VitalCare Team",
            "email": "admin@vitalcare.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost",
            "description": "VitalCare Pharmacy API Server"
        }
    ],
    "paths": {
        "/api/admin/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "List all categories with statistics",
                "operationId": "48cfaa7170afec6cf86a79a6c0dff452",
                "responses": {
                    "200": {
                        "description": "List of categories with products count and metrics",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "categories": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "stats": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Categories"
                ],
                "summary": "Create single category or bulk categories",
                "description": "Provide \"name\" for single creation, or \"categories\" array for bulk creation with duplicate control.",
                "operationId": "1045104c0f234aaa53facdf2c66bb7ba",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "description": "Used for single creation",
                                        "type": "string",
                                        "example": "Pain & Fever Relief"
                                    },
                                    "categories": {
                                        "description": "Used for bulk creation",
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "Pain & Fever Relief",
                                            "Eye Care",
                                            "Digestive & Rehydration"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Category or categories created successfully"
                    },
                    "200": {
                        "description": "Partial creation (some succeeded, duplicates failed)"
                    },
                    "422": {
                        "description": "Validation error or already present"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/admin/units": {
            "get": {
                "tags": [
                    "Units"
                ],
                "summary": "List all units with statistics",
                "operationId": "88618e897f9df49f51296444a504f73d",
                "responses": {
                    "200": {
                        "description": "List of units with product count and most used unit metric",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "units": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "stats": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Units"
                ],
                "summary": "Create single unit or bulk units",
                "description": "Provide \"name\" for single creation, or \"units\" array for bulk creation with duplicate control.",
                "operationId": "28b434cdeccfa5b5a453e802ab2469c1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "description": "Used for single creation",
                                        "type": "string",
                                        "example": "Strip"
                                    },
                                    "units": {
                                        "description": "Used for bulk creation",
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "Strip",
                                            "Box",
                                            "Bottle",
                                            "Piece"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Unit or units created successfully"
                    },
                    "200": {
                        "description": "Partial creation (some succeeded, duplicates failed)"
                    },
                    "422": {
                        "description": "Validation error or already present"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User & Admin login",
                "description": "Authenticates user credentials and returns a JWT Bearer token.",
                "operationId": "8dcb70df1020986038d098cc08d05dae",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@vitalcare.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Admin@122"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string",
                                            "example": "eyJhbGciOi..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "bearer"
                                        },
                                        "expires_in": {
                                            "type": "integer",
                                            "example": 3600
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid email or password"
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get authenticated user profile and permissions",
                "operationId": "b9abb1a7a74670a19c215c2c133f14d8",
                "responses": {
                    "200": {
                        "description": "User details with assigned permissions",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "System Admin"
                                        },
                                        "email": {
                                            "type": "string",
                                            "example": "admin@vitalcare.com"
                                        },
                                        "role": {
                                            "type": "string",
                                            "example": "admin"
                                        },
                                        "permissions": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "example": "categories.crud"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products (Catalog)"
                ],
                "summary": "Browse catalog products",
                "description": "Returns published non-expired products with pagination, category filter, and search.",
                "operationId": "1bfaa78d1c2c3848ab8165c5dadcad3e",
                "parameters": [
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "Filter by Category ID",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by Product Name",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 62
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/products/{id}": {
            "get": {
                "tags": [
                    "Products (Catalog)"
                ],
                "summary": "Get product details by ID",
                "operationId": "7ab21ddb713501f3d4c2914892c02a21",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product details and related recommendations"
                    },
                    "404": {
                        "description": "Product not found"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Enter your JWT token in the format: Bearer <your-token>",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Categories",
            "description": "Categories"
        },
        {
            "name": "Units",
            "description": "Units"
        },
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Products (Catalog)",
            "description": "Products (Catalog)"
        }
    ]
}